# Optional API base URL. Leave empty for same-origin `/api` (served through the
# Nginx reverse proxy in the Docker runtime), or set the absolute backend URL to
# call Laravel directly (e.g. http://localhost:8000). Copy to frontend/.env.
VITE_API_URL=

# Optional dev-server proxy target. Only read by the Vite dev server to forward
# `/api` and `/storage` when the SPA is opened directly on :5173. Under Docker
# Compose this is set to http://backend:8000 automatically; a standalone host
# dev run may leave it unset (falls back to VITE_API_URL, then localhost:8000).
# VITE_PROXY_TARGET=http://localhost:8000