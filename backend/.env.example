APP_NAME="StudyBack"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=studyback
DB_USERNAME=studyback
DB_PASSWORD=studyback_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Studyback AI integration (provider-agnostic, Tech Stack §7.3)
# ---------------------------------------------------------------------------
# Active provider: openrouter (default) | featherless | mock (dev/test)
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free

# Optional fallback provider, tried after the active provider exhausts retries
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=

# Request & retry settings
AI_REQUEST_TIMEOUT=60
AI_MAX_TOKENS=2048
AI_RETRY_ATTEMPTS=1
AI_RETRY_DELAY_MS=250

# Provider credentials / endpoints
OPENROUTER_API_KEY=
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=

# Mock provider overrides (dev/test only)
# MOCK_AI_FAILURE=
# MOCK_AI_TOPICS=
# MOCK_AI_QUESTIONS=
# MOCK_AI_EVALUATION=
# MOCK_AI_EXPLANATION=

# Optional path to the pdftotext binary for non-Docker environments
# PDFTOTEXT_BIN=

# CORS - comma-separated list of browser origins allowed to call the API directly.
# Empty default in config/cors.php covers common local dev origins.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
