# Application
APP_NAME=Studyback
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Docker Ports
NGINX_PORT=80
FRONTEND_PORT=5173
BACKEND_PORT=8000
DB_PORT=5432

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=studyback
DB_USERNAME=studyback
DB_PASSWORD=studyback_password

# Cache & Session
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# Vite - base URL for the Laravel API.
# Empty => same-origin "/api" (routed by the Nginx reverse proxy).
# Set e.g. http://localhost:8000 to call the backend directly (CORS-enabled).
VITE_API_URL=
